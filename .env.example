# Copie para .env.local no seu computador. Na Vercel, cadastre em
# Project Settings → Environment Variables.

# Endereço público do site, sem barra no final (ex.: https://faisca.com.br).
# Na Vercel, se ficar vazio, o projeto usa o domínio da própria Vercel.
NEXT_PUBLIC_SITE_URL=

# Mercado Pago → Suas integrações → sua aplicação → Credenciais de produção
# (use as credenciais de teste enquanto estiver testando).
MP_ACCESS_TOKEN=

# Mercado Pago → Suas integrações → Webhooks → "Assinatura secreta".
# Cadastre a URL https://SEU-DOMINIO/api/webhooks/mercadopago com o evento "Pagamentos".
MP_WEBHOOK_SECRET=

# Parcelamento máximo no cartão oferecido no checkout.
MP_MAX_INSTALLMENTS=3

# Frete fixo em reais para todo o Brasil (0 = frete grátis). Ajuste depois com uma
# tabela por CEP ou Mercado Envios, se preferirem.
FRETE_FIXO=0

# Banco de dados (pedidos, estoque e lista de e-mails).
# Na Vercel: Storage → Upstash for Redis → Connect to project.
# A integração cria estas duas variáveis sozinha.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Dados da empresa (obrigatórios por lei para vender online — Decreto 7.962/2013) ──
# Aparecem no rodapé de todas as páginas, na Ajuda e na Privacidade.
NEXT_PUBLIC_RAZAO_SOCIAL=
NEXT_PUBLIC_CNPJ=
NEXT_PUBLIC_EMAIL_CONTATO=
# Endereço exibido no rodapé (padrão: Curitiba, PR).
NEXT_PUBLIC_ENDERECO=Curitiba, PR
# Dias úteis para postar o pedido depois do pagamento (ex.: 3). Vazio = "em poucos dias úteis".
NEXT_PUBLIC_PRAZO_POSTAGEM=

# Senha longa para baixar as listas de "avise-me" em CSV:
# https://SEU-DOMINIO/api/avise-me?lista=gio-soifer&token=ESTA_SENHA
# Gere uma com pelo menos 32 caracteres (ex.: um gerenciador de senhas).
ADMIN_TOKEN=
